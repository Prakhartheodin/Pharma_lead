# Shared secret for api <-> scraper calls. MUST match api/.env.
PHARMA_WORKER_SECRET=change-me-to-a-long-random-string

# Where the scraper streams leads back to (docker-compose: http://api:3000)
NODE_CALLBACK_BASE=http://localhost:3000

# OpenAI — GPT-4o-mini classification
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# Crawl checkpoint dir (Scrapling crawldir) — mounted as a volume in compose
CHECKPOINT_DIR=/app/checkpoints
