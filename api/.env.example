NODE_ENV=development
PORT=3000

# Mongo (docker-compose sets this to mongodb://mongo:27017/pharma)
MONGODB_URL=mongodb://127.0.0.1:27017/pharma

# Scrapling service (docker-compose: http://scraper:8000)
SCRAPER_URL=http://localhost:8000
# Base URL the scraper calls back to (docker-compose: http://api:3000)
NODE_CALLBACK_BASE=http://localhost:3000

# Shared secret for Node <-> scraper calls. MUST match scraper/.env.
PHARMA_WORKER_SECRET=change-me-to-a-long-random-string

# Google Places API (New) — discovery
GOOGLE_PLACES_API_KEY=

# OpenAI (GPT-4o-mini classification happens in the scraper, but keep here if api needs it)
OPENAI_API_KEY=

# GCP Gmail OAuth (ported from Dharwin) — Gmail API enabled + OAuth consent screen
GCP_GOOGLE_CLIENT_ID=
GCP_GOOGLE_CLIENT_SECRET=
GCP_GOOGLE_REDIRECT_URI=http://localhost:3000/v1/email/auth/google/callback

# CORS origin for the React frontend
CORS_ORIGIN=http://localhost:3001
